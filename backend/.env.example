# Copy this file to .env and fill in your actual values.
# Never commit .env to version control — it is in .gitignore.

# ── LLM Providers ────────────────────────────────────────────────────────────
# Required. Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here

# Optional: second Groq key for automatic rate-limit fallback.
# Each key is a separate Groq account with its own daily token budget.
# GROQ_API_KEY_2=your_second_groq_key_here

# Required. Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here

# Optional: Gemini key for long-context patient history retrieval.
# Get at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# ── Model overrides (optional) ────────────────────────────────────────────────
# Defaults shown — override only if you want a different model.
MODEL_FAST=openai/gpt-oss-20b
MODEL_REASONING=openai/gpt-oss-120b
MODEL_LONGCTX=gemini-3.6-flash

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev: SQLite (no setup needed, file created automatically).
# Production (Railway): replace with your PostgreSQL connection string.
DATABASE_URL=sqlite:///./clinical_assistant.db
SESSION_DB_PATH=./sessions.db

# ── Email notifications (optional) ───────────────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@example.com

# ── App ───────────────────────────────────────────────────────────────────────
ENV=development

# Comma-separated list of allowed frontend origins (no trailing slash).
# Next.js dev server auto-increments ports (3000 → 3001 → 3002) if the port
# is in use, so all three are listed here for local development.
# Add your Vercel production domain before deploying.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,https://your-frontend.vercel.app

LOG_LEVEL=INFO
